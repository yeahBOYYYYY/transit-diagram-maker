{
  "name": "transit-diagram-maker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/transit-wasm --target web --out-dir ../../web/src/wasm/pkg --release",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test screenshots"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
